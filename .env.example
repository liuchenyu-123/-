# Server-side only. Copy to .env.local for local development.
# Leave all three blank to run the deterministic rule engine (no network, no key needed).
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Optional shelf-photo recognition (OpenAI-compatible /chat/completions with image_url).
# VISION_MODEL is REQUIRED to enable it - a text-only LLM_MODEL is never sent an image.
# The key is only read on the server. Without these, /api/vision returns clearly
# labelled demo drafts so the full photo -> review -> prediction loop still works.
# Leave VISION_API_BASE / VISION_API_KEY blank to reuse LLM_API_BASE / LLM_API_KEY.
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=

# Live weather: Open-Meteo is free and needs no key. Override the endpoint for a
# proxy or self-hosted mirror; set WEATHER_MODE=off to force fully offline operation.
WEATHER_API_BASE=
WEATHER_MODE=on

# Outbound provider calls automatically honour the standard HTTPS_PROXY / HTTP_PROXY
# environment variables (undici ProxyAgent). Nothing to set here on most hosts.

# Public site URL, used in generated share links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default UI language when a visitor has no language cookie: zh (default) or en.
# Visitors can always switch in the top-right nav; the cookie then takes precedence.
DEFAULT_LANG=zh
